# AIDOL 環境變數範例。全部都是選填；需要時複製成 .env.local 或在終端機設定。
# .env 與 .env.* 不會進版本控制，請不要把本機路徑或憑證寫進這個範例檔。

# ── 本機核心（server/）──
# 角色資料庫位置，預設為專案下的 .aidol/
# AIDOL_DATA_DIR=
# 本機核心 port，預設 4318（只綁定 127.0.0.1）
# AIDOL_PORT=4318
# 前端靜態檔位置，預設為 dist/client；AIDOL_CLIENT_DIR 與 AIDOL_STATIC_DIR 擇一設定即可
# AIDOL_CLIENT_DIR=
# 示範角色圖位置，預設為 public/assets（或 AIDOL_PUBLIC_DIR/assets）
# AIDOL_ASSET_DIR=
# AIDOL_PUBLIC_DIR=
# 額外允許存取本機核心的 Origin，以逗號分隔、不要加空白
# AIDOL_ALLOWED_ORIGINS=
# 指定 Codex CLI 執行檔，預設自動尋找
# AIDOL_CODEX_BINARY=

# ── AIDOL Skill ──
# 要安裝的 skill 來源，預設為 .agents/skills/aidol
# AIDOL_SKILL_SOURCE=
# Codex 設定目錄，skill 會安裝到 $CODEX_HOME/skills/aidol，預設 ~/.codex
# CODEX_HOME=

# ── 建置 ──
# sidecar 的目標平台，預設依目前系統判斷
# AIDOL_TARGET_TRIPLE=x86_64-pc-windows-msvc
# 編譯 sidecar 用的 bun 執行檔
# AIDOL_BUN_BINARY=

# ── Vite 開發伺服器 ──
# 綁定位址，預設 127.0.0.1。設成 0.0.0.0 會讓區網裡的人經由 /api 讀寫你的角色資料，確定需要才改。
# AIDOL_DEV_HOST=127.0.0.1
# 用自訂主機名稱開啟開發伺服器時允許的 host，以逗號分隔
# AIDOL_DEV_ALLOWED_HOSTS=
